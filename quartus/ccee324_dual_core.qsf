# CCEE 324 Dual-Core Processor - Quartus Prime Lite 21.1 project settings
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY dual_core_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 21.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "21.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

# Simulation tool (we run Questa from the repo root, see README)
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation

# Hex files: Quartus runs from quartus/, so it needs paths one level up
set_parameter -name PROG0 "../programs/core0.hex"
set_parameter -name PROG1 "../programs/core1.hex"
set_parameter -name DATA "../programs/data.hex"

# Design files (src/ only - testbenches are NOT design files)
set_global_assignment -name VERILOG_FILE ../src/alu.v
set_global_assignment -name VERILOG_FILE ../src/regfile.v
set_global_assignment -name VERILOG_FILE ../src/decoder.v
set_global_assignment -name VERILOG_FILE ../src/control_unit.v
set_global_assignment -name VERILOG_FILE ../src/pc_unit.v
set_global_assignment -name VERILOG_FILE ../src/instr_mem.v
set_global_assignment -name VERILOG_FILE ../src/shared_mem.v
set_global_assignment -name VERILOG_FILE ../src/core.v
set_global_assignment -name VERILOG_FILE ../src/dual_core_top.v
